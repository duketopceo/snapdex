#!/bin/sh
# Disable auto-processing. Pass --purge to also delete the unit files.
set -eu
UNITDIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/snapdex"
systemctl --user disable --now snapdex.path 2>/dev/null || true
rm -f "$STATE/auto_since"
if [ "${1:-}" = "--purge" ]; then
  rm -f "$UNITDIR/snapdex.path" "$UNITDIR/snapdex.service"
  systemctl --user daemon-reload
fi
